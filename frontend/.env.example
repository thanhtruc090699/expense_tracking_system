# Frontend environment variables for Vite
# Copy this file to .env and replace values as needed.
#
# Use the host your browser can reach for the backend and Keycloak.
# Common local values:
#   - http://localhost
#   - http://127.0.0.1
#   - http://10.0.0.2
#
# If your Keycloak runs on port 8080, include it in VITE_KEYCLOAK_URL.

# Backend host for frontend API requests.
# Example values:
#   VITE_ALLOWED_HOSTS=http://localhost
#   VITE_ALLOWED_HOSTS=http://127.0.0.1
#   VITE_ALLOWED_HOSTS=http://10.0.0.2
VITE_ALLOWED_HOSTS=http://localhost

# Keycloak base URL for authentication.
# Example values:
#   VITE_KEYCLOAK_URL=http://localhost:8080
#   VITE_KEYCLOAK_URL=http://127.0.0.1:8080
#   VITE_KEYCLOAK_URL=http://10.0.0.2:8080
VITE_KEYCLOAK_URL=http://127.0.0.1:8080
