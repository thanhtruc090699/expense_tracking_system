generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BudgetType {
  TOTAL
  MONTHLY
  CATEGORY
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  password      String
  username      String?
  avatar        String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  categories    Category[]
  budgets       Budget[]
  expenses      Expense[]
  bills         Bill[]
}

model Category {
  id        String   @id @default(uuid())
  name      String
  isDefault Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgets   Budget[]
  expenses  Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, userId])
}

model Budget {
  id         String     @id @default(uuid())
  type       BudgetType
  amount     Decimal    @db.Decimal(10, 2)
  categoryId String?
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([type, categoryId, userId])
}

model Expense {
  id         String   @id @default(uuid())
  amount     Decimal  @db.Decimal(10, 2)
  date       DateTime
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  billId     String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Bill {
  id          String   @id @default(uuid())
  fileUrl     String
  fileType    String
  ocrData     Json?
  isDuplicate Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}