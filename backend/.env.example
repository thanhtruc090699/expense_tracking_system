# Server
PORT=3000
BACKEND_URL=http://localhost:3000

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://billbuddy:billbuddy@localhost:5432/billbuddy?schema=public"

# Lisa AI API
