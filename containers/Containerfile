FROM php:8.2-cli

RUN apt-get update && apt-get install -y \
    tesseract-ocr \
    poppler-utils \
    git \
    unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY composer.json ./
RUN composer install --no-dev --optimize-autoloader || (curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer && composer install --no-dev --optimize-autoloader)

COPY . .

EXPOSE 8000

CMD ["php", "-S", "0.0.0.0:8000", "-t", "public", "public/api.php"]
